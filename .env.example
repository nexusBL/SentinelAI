# SentinelAI environment configuration
# Copy this file to `.env` and adjust values as needed.

# Browser runtime
SENTINELAI_BROWSER_HEADLESS=true
SENTINELAI_BROWSER_VIEWPORT_WIDTH=1440
SENTINELAI_BROWSER_VIEWPORT_HEIGHT=900
SENTINELAI_BROWSER_NAVIGATION_TIMEOUT_MS=30000
SENTINELAI_BROWSER_WAIT_UNTIL=load

# Artifact storage
SENTINELAI_ARTIFACTS_DIR=artifacts

# Ollama planner
SENTINELAI_OLLAMA_ENDPOINT=http://localhost:11434/api/generate
SENTINELAI_OLLAMA_MODEL=llama3
SENTINELAI_OLLAMA_TIMEOUT_SECONDS=60
SENTINELAI_OLLAMA_MAX_ATTEMPTS=3

# LangGraph orchestration
SENTINELAI_GRAPH_MAX_RETRIES=2

# Persistent memory
SENTINELAI_MEMORY_ENABLED=true
SENTINELAI_MEMORY_VECTOR_DB_PATH=memory_store
SENTINELAI_MEMORY_EMBEDDING_PROVIDER=hashing
SENTINELAI_MEMORY_EMBEDDING_MODEL=hashing-384
SENTINELAI_MEMORY_TOP_K=3

# MCP tool layer
SENTINELAI_MCP_ENABLED=true
SENTINELAI_MCP_TOOL_TRACING_ENABLED=true
SENTINELAI_MCP_TIMEOUT_SECONDS=90
SENTINELAI_MCP_ENABLED_TOOLS=browser,memory,validation

# Dashboard
# The dashboard reads the same shared SentinelAI runtime settings above.

# Authentication
SENTINELAI_AUTH_ENABLED=true
SENTINELAI_AUTH_JWT_SECRET=change-this-local-development-secret-32-plus-bytes
SENTINELAI_AUTH_TOKEN_EXPIRE_MINUTES=1440
SENTINELAI_AUTH_COOKIE_NAME=sentinelai_session
SENTINELAI_AUTH_SECURE_COOKIE=false
# Legacy Phase 14 compatibility only. Phase 15 stores users in the metadata DB.
# SENTINELAI_AUTH_SQLITE_PATH=auth_store/sentinelai_auth.db

# Metadata database
SENTINELAI_DATABASE_SQLITE_PATH=metadata_store/sentinelai_metadata.db
# Optional full SQLAlchemy URL override. Keep unset for local SQLite path behavior.
# SENTINELAI_DATABASE_URL=sqlite:///metadata_store/sentinelai_metadata.db

# Local production deployment
# Docker Compose serves the dashboard through NGINX on localhost:8000.
# If Ollama runs on the host machine, containers should use host.docker.internal.
# For direct local Python usage, localhost is still correct.
# SENTINELAI_OLLAMA_ENDPOINT=http://host.docker.internal:11434/api/generate
SENTINELAI_DASHBOARD_HOST=0.0.0.0
SENTINELAI_DASHBOARD_PORT=8000
